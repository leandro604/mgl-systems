# MGL Systems — cliente Supabase (valores públicos permitidos en navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web Push — esta clave pública sí puede llegar al navegador.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# -------------------------------------------------------------------
# Next.js server-only: Intifact
# También configurar INTIFACT_API_KEY como secreto de la Edge Function
# `emitir-factura` en Supabase.
# -------------------------------------------------------------------
INTIFACT_API_KEY=

# Supabase Edge Function `intifact-webhook` solamente.
# Debe coincidir con el secreto configurado en el webhook de Intifact.
INTIFACT_WEBHOOK_SECRET=


# -------------------------------------------------------------------
# Tarea 13 reforzada v2 — SUNAT directo / secretos fiscales
# Esta MISMA clave debe configurarse también como secreto de la Edge
# Function `emitir-factura` para descifrar SOL y el certificado PFX/P12.
# Genera una clave larga y estable; no la cambies con credenciales guardadas.
# -------------------------------------------------------------------
FISCAL_CREDENTIALS_ENCRYPTION_KEY=

# -------------------------------------------------------------------
# Next.js server-only: Google Drive / OneDrive OAuth
# DRIVE_TOKEN_ENCRYPTION_KEY debe ser un secreto largo, estable y privado.
# No cambiarlo mientras existan refresh tokens cifrados con esa clave.
# -------------------------------------------------------------------
DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
MICROSOFT_DRIVE_CLIENT_ID=
MICROSOFT_DRIVE_CLIENT_SECRET=
# Opcional. Por defecto se usa `common`.
MICROSOFT_DRIVE_TENANT_ID=common

# -------------------------------------------------------------------
# Worker de notificaciones Supabase Edge Functions (server-only)
# -------------------------------------------------------------------
MGL_NOTIFICATION_WORKER_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=MGL Systems <avisos@tu-dominio.com>
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tu-dominio.com
MGL_APP_URL=http://localhost:3000

# Nunca expongas service_role, sb_secret_*, secretos OAuth, claves de cifrado
# ni credenciales PSE usando prefijos NEXT_PUBLIC_.

# -------------------------------------------------------------------
# Tarea 14 reforzada — webhooks Drive/OneDrive (server-only)
# MGL_APP_URL debe ser HTTPS público para activar sincronización automática.
# DRIVE_WEBHOOK_SECRET firma/valida el canal; si se omite, se usa
# DRIVE_TOKEN_ENCRYPTION_KEY como fallback.
# El webhook server-side necesita una clave Supabase privilegiada.
# -------------------------------------------------------------------
DRIVE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
